{
  "properties": {
    "displayName": "Require a tag on resource groups",
    "description": "Audits or denies resource groups that don't have the named tag. Companion code for chapter 10 of Azure Landing Zones (Ultra Transcenders).",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Tags",
      "version": "1.0.0"
    },
    "parameters": {
      "tagName": {
        "type": "String",
        "defaultValue": "costCentre",
        "metadata": {
          "displayName": "Tag name",
          "description": "Name of the tag every resource group must have, such as 'costCentre'."
        }
      },
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Audit reports missing tags; Deny blocks the create or update; Disabled turns the rule off."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions/resourceGroups"
          },
          {
            "field": "[concat('tags[', parameters('tagName'), ']')]",
            "exists": "false"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
